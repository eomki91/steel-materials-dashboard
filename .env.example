# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.

# ── LLM API 키 ───────────────────────────────────────────────
# 둘 중 하나만 있으면 됩니다. 둘 다 있으면 OPENAI 를 우선 사용합니다.
# 키가 하나도 없어도 앱은 실행됩니다 (AI Summary 화면만 안내 문구로 대체).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 사용할 모델 (선택, 비워두면 아래 기본값)
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-opus-5

# ── 데이터 소스 ──────────────────────────────────────────────
# World Bank Pink Sheet 월간 과거 데이터 엑셀.
# 경로에 연도 코드(0050012026)가 포함되어 매년 바뀝니다.
# 404 가 나면 아래 페이지에서 "Monthly prices (XLS)" 최신 링크를 복사해 교체하세요.
#   https://www.worldbank.org/en/research/commodity-markets
WORLDBANK_XLSX_URL=https://thedocs.worldbank.org/en/doc/74e8be41ceb20fa0da750cda2f6b9e4e-0050012026/related/CMO-Historical-Data-Monthly.xlsx
